{
  "name": "dsh-tacitweave",
  "version": "0.2.1-test.1",
  "description": "TEST-ONLY TacitWeave personal interaction-policy calibration bundle for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./src/core.js",
    "./paths": "./src/paths.js",
    "./web-api": "./src/web-api.js",
    "./client": "./.dsh-plugin/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "personal-model-context": "./bin/export-context.mjs",
    "weave-ingest": "./bin/weave-ingest.mjs",
    "weave-review": "./bin/weave-review.mjs"
  },
  "files": [
    "index.js",
    ".dsh-plugin/",
    "src/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "docs/",
    "schemas/",
    "skills/",
    "scenarios/",
    "examples/"
  ],
  "scripts": {
    "check": "node --check index.js && node --check src/core.js && node --check src/paths.js && node --check src/store.js && node --check src/weavespec.js && node --check src/web-api.js && node --check .dsh-plugin/client.js && node --check bin/export-context.mjs && node --check bin/weave-ingest.mjs && node --check bin/weave-review.mjs",
    "test": "node --test \"test/*.test.js\"",
    "pack:dry": "npm pack --dry-run --cache ./.npm-cache"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "personal-model",
    "human-ai-interaction",
    "experimental"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6"
  }
}
