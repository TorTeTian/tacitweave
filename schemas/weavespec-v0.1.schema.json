{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TorTeTian/tacitweave/schemas/weavespec-v0.1.schema.json",
  "title": "WeaveSpec Personal Model",
  "description": "A platform-neutral, evidence-grounded personal preference model for human-AI collaboration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "updated_at", "preferences", "safety_invariants"],
  "properties": {
    "schema_version": { "const": "weavespec/0.1" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "preferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/preference" }
    },
    "safety_invariants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "claim", "dimension", "scope", "exclusions",
        "evidence", "confidence", "status", "sensitivity", "confirmed_at",
        "last_reviewed_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,160}$" },
        "kind": {
          "enum": ["interaction_preference", "decision_boundary", "user_fact", "temporary_context"]
        },
        "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "dimension": {
          "enum": ["autonomy", "confirmation", "decision_ownership", "communication", "explanation", "privacy", "format", "other"]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domains", "actions", "risk", "reversibility", "projects"],
          "properties": {
            "domains": { "$ref": "#/$defs/stringArray" },
            "actions": { "$ref": "#/$defs/stringArray" },
            "risk": {
              "type": "array",
              "items": { "enum": ["low", "medium", "high", "critical", "unspecified"] },
              "uniqueItems": true
            },
            "reversibility": {
              "type": "array",
              "items": { "enum": ["reversible", "partly_reversible", "irreversible", "unspecified"] },
              "uniqueItems": true
            },
            "projects": { "$ref": "#/$defs/stringArray" }
          }
        },
        "exclusions": { "$ref": "#/$defs/stringArray" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "message_id", "timestamp", "excerpt", "excerpt_sha256"],
            "properties": {
              "source_id": { "type": "string", "minLength": 1, "maxLength": 160 },
              "message_id": { "type": ["string", "null"], "maxLength": 200 },
              "timestamp": { "type": ["string", "null"], "format": "date-time" },
              "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "excerpt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["candidate", "user_confirmed", "rejected", "superseded"] },
        "sensitivity": { "enum": ["normal", "sensitive"] },
        "conflicts_with": { "$ref": "#/$defs/stringArray" },
        "confirmed_at": { "type": ["string", "null"], "format": "date-time" },
        "last_reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    }
  }
}
